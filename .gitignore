# Secrets — never commit
.env
gh token.txt
*token*.txt
*.token

# Python
__pycache__/
*.pyc

# Scraper debug screenshots / page snapshots
*.png
*.html

# Generated audit output (regenerate with: py price_audit.py audit)
price_audit_suspects.csv

# Unrelated files — not part of the bot
idx-research-agent.jsx
modern_ta_checklist.tsx
phase1_tf.md

# Phase 2A/2B ownership artifacts
# Raw authenticated capture cache (pane text + chart JSON, one subdir per run_id) —
# resumable same-day scrape cache only, never a durable record; never commit.
ownership_raw/
# ownership_raw_fragments/ is the OPPOSITE of the above and is deliberately NOT
# ignored: immutable, content-addressed, gzipped pane fragments written by
# ownership_ingest.store_pane_fragment(), indexed in capture_payload. This is
# the durable bitemporal evidence store (see the ownership capture-durability
# remediation) — an unchanged pane costs zero additional bytes across runs, so
# committing it stays cheap. Do not add an ignore rule for it here.
# neobdm_ownership.db is now an intentional tracked production artifact as of
# Phase 2B (see ownership-capture.yml) — committed by that workflow the same
# way neobdm.db is committed by daily-scrape.yml / price-history-topup.yml.
# Discovery scratch files written during capture probing sessions
scratch_ownership_panes*.json
# Any other raw HTML pages or session snapshots (ownership_capture.py
# explicitly avoids writing full HTML, but belt-and-suspenders)
*_raw*.html
*_page*.html

